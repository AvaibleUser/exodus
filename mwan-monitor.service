# /etc/systemd/system/mwan-monitor.service
[Unit]
Description=Multi-WAN XelajuNetwork - failover y recuperacion automaticos
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/local/sbin/mwan-apply --quiet
ExecStart=/usr/local/sbin/mwan-monitor
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
